{
	"name": "haste",
	"version": "0.2.5",
	"description": "Private Pastebin Server - continued by zneix",
	"keywords": [
		"paste",
		"pastebin",
		"haste",
		"hastebin"
	],
	"author": {
		"name": "John Crepezzi",
		"email": "john.crepezzi@gmail.com",
		"url": "http://seejohncode.com/"
	},
	"main": "app.js",
	"dependencies": {
		"@fastify/sensible": "^5.1.0",
		"@fastify/static": "^6.5.0",
		"fastify": "^4.3.0",
		"ioredis": "^5.2.2",
		"mongodb": "^4.8.1",
		"pg": "^8.7.3",
		"pino": "^8.3.1",
		"pino-pretty": "^8.1.0"
	},
	"devDependencies": {
		"@babel/cli": "^7.18.10",
		"@babel/core": "^7.18.10",
		"babel-plugin-minify-mangle-names": "^0.5.1",
		"eslint": "^8.21.0",
		"eslint-plugin-unicorn": "^43.0.2",
		"mocha": "^10.0.0"
	},
	"scripts": {
		"build": "yarn && npx babel --plugins minify-mangle-names --no-comments --minified static/js/application.js --out-file static/js/application.min.js",
		"start": "node app.js",
		"test": "mocha --recursive",
		"testformat": "npx eslint ./"
